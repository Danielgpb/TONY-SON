---
// Facade légère pour un YouTube Short (9:16) : miniature locale + bouton play,
// l'iframe youtube-nocookie n'est injectée qu'au clic (zéro JS YouTube au chargement).
interface Props {
  locale: 'fr' | 'en' | 'nl';
  video?: 'balayage' | 'enseigne';
}

const { locale, video = 'balayage' } = Astro.props;

const VIDEOS = {
  balayage: {
    id: 'xB8mCNwOyAw',
    thumb: '/images/video-balayage-short.webp',
    uploadDate: '2026-08-16T04:10:38-07:00',
    i18n: {
      fr: {
        title: 'Balayage & brushing en salon — Coiffeur à Saint-Josse, Bruxelles | Tony&Son',
        description:
          'Balayage et brushing réalisés en salon chez Tony&Son, coiffeur à Saint-Josse-ten-Noode (Bruxelles), rue Bonneels 27, à deux pas du métro Schuman.',
        play: 'Lire la vidéo : balayage & brushing en salon',
        caption: 'Balayage & brushing en salon — en vidéo',
      },
      en: {
        title: 'Balayage & blowout in the salon — Hairdresser in Saint-Josse, Brussels | Tony&Son',
        description:
          'Balayage and blowout performed at Tony&Son, hairdresser in Saint-Josse-ten-Noode (Brussels), Rue Bonneels 27, steps from Schuman metro.',
        play: 'Play video: balayage & blowout in the salon',
        caption: 'Balayage & blowout in the salon — on video',
      },
      nl: {
        title: 'Balayage & brushing in het salon — Kapper in Sint-Joost, Brussel | Tony&Son',
        description:
          'Balayage en brushing uitgevoerd bij Tony&Son, kapper in Sint-Joost-ten-Node (Brussel), Bonneelsstraat 27, vlak bij metro Schuman.',
        play: 'Video afspelen: balayage & brushing in het salon',
        caption: 'Balayage & brushing in het salon — op video',
      },
    },
  },
  enseigne: {
    id: '9N5CNW2pSN0',
    thumb: '/images/video-enseigne-short.webp',
    uploadDate: '2026-09-17T04:18:51-07:00',
    i18n: {
      fr: {
        title:
          "L'histoire derrière notre enseigne — Tony&Son, coiffeur à Saint-Josse depuis 1970",
        description:
          "L'histoire de l'enseigne Tony&Son, salon de coiffure familial fondé en 1970 par Tony Campisi et repris par son fils Salvatore, rue Bonneels 27 à Saint-Josse-ten-Noode (Bruxelles).",
        play: "Lire la vidéo : l'histoire derrière l'enseigne Tony&Son",
        caption: "L'histoire derrière notre enseigne — en vidéo",
      },
      en: {
        title: 'The story behind our sign — Tony&Son, hairdresser in Saint-Josse since 1970',
        description:
          'The story of the Tony&Son sign, a family hair salon founded in 1970 by Tony Campisi and taken over by his son Salvatore, Rue Bonneels 27 in Saint-Josse-ten-Noode (Brussels).',
        play: 'Play video: the story behind the Tony&Son sign',
        caption: 'The story behind our sign — on video',
      },
      nl: {
        title: 'Het verhaal achter ons uithangbord — Tony&Son, kapper in Sint-Joost sinds 1970',
        description:
          'Het verhaal achter het uithangbord van Tony&Son, een familiekapsalon opgericht in 1970 door Tony Campisi en overgenomen door zijn zoon Salvatore, Bonneelsstraat 27 in Sint-Joost-ten-Node (Brussel).',
        play: 'Video afspelen: het verhaal achter het uithangbord van Tony&Son',
        caption: 'Het verhaal achter ons uithangbord — op video',
      },
    },
  },
} as const;

const v = VIDEOS[video];
const t = v.i18n[locale] ?? v.i18n.fr;

const videoSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: t.title,
  description: t.description,
  thumbnailUrl: `https://tonyandson.be${v.thumb}`,
  uploadDate: v.uploadDate,
  embedUrl: `https://www.youtube-nocookie.com/embed/${v.id}`,
  contentUrl: `https://www.youtube.com/shorts/${v.id}`,
  publisher: { '@id': 'https://tonyandson.be/#business' },
});
---

<figure class="yt-short">
  <button
    type="button"
    class="yt-short__facade"
    data-video-id={v.id}
    data-video-title={t.title}
    aria-label={t.play}
  >
    <img src={v.thumb} alt={t.caption} width="480" height="854" loading="lazy" decoding="async" />
    <span class="yt-short__play" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="52" height="37">
        <path
          d="M66.52 7.74a8 8 0 0 0-5.66-5.66C55.79.6 34 .6 34 .6s-21.79 0-26.86 1.48a8 8 0 0 0-5.66 5.66C0 12.81 0 24 0 24s0 11.19 1.48 16.26a8 8 0 0 0 5.66 5.66C12.21 47.4 34 47.4 34 47.4s21.79 0 26.86-1.48a8 8 0 0 0 5.66-5.66C68 35.19 68 24 68 24s0-11.19-1.48-16.26z"
          fill="#f00"></path>
        <path d="M45 24 27 14v20" fill="#fff"></path>
      </svg>
    </span>
  </button>
  <figcaption class="yt-short__caption">{t.caption}</figcaption>
</figure>

<script type="application/ld+json" set:html={videoSchema} is:inline />

<style>
  .yt-short {
    margin: 0;
    width: 100%;
    max-width: 240px;
  }
  .yt-short__facade {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    background: #000;
  }
  .yt-short__facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }
  .yt-short__facade:hover img,
  .yt-short__facade:focus-visible img {
    opacity: 0.85;
  }
  .yt-short__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
  }
  .yt-short__caption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    opacity: 0.75;
    text-align: center;
  }
  .yt-short :global(iframe) {
    width: 100%;
    height: 100%;
    aspect-ratio: 9 / 16;
    border: 0;
    border-radius: 12px;
    display: block;
  }
</style>

<script is:inline>
  document.querySelectorAll('.yt-short__facade').forEach((btn) => {
    btn.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src =
          'https://www.youtube-nocookie.com/embed/' +
          btn.dataset.videoId +
          '?autoplay=1&playsinline=1';
        iframe.title = btn.dataset.videoTitle;
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        btn.replaceWith(iframe);
      },
      { once: true }
    );
  });
</script>
